# Lab identifiers — copy to .env.lab (gitignored) and fill.
#   cp .env.lab.example .env.lab && chmod 600 .env.lab
# Then: direnv allow   (or: set -a && . ./.env.lab && set +a)
#
# Do not commit .env.lab. Do not put Tailscale IPs or Syncthing device IDs in markdown.

# Host labels (fleet 2026-09 bring-up uses linux-node + mac-node; generic lab may use other names)
MESH_HOST_A=linux-node
MESH_HOST_B=mac-node
MESH_TS_A=100.x.x.x
MESH_TS_B=100.y.y.y
# If B cannot bind mesh :47989, set the port it actually uses:
# MESH_WEB_PORT_B=18789

# Peer longnames for ~/.config/mesh/nodes (one mesh@<ip> per line; generate from MESH_TS_*):
#   mesh@${MESH_TS_A}
#   mesh@${MESH_TS_B}

# RustDesk self-hosted rendezvous on linux-node (typical default)
# RUSTDESK_HBBS_PORT=21116

ST_DEVICE_A=
ST_DEVICE_B=
ST_FOLDER_ID=sync
SYNC_FOLDER=$HOME/sync
