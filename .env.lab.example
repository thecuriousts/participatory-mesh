# Lab identifiers — copy to .env.lab (gitignored) and fill.
#   cp .env.lab.example .env.lab && chmod 600 .env.lab
# Then: direnv allow   (or: set -a && . ./.env.lab && set +a)
#
# Do not commit .env.lab. Do not put Tailscale IPs or Syncthing device IDs in markdown.

MESH_HOST_A=laptop-a
MESH_HOST_B=laptop-b
MESH_TS_A=100.x.x.x
MESH_TS_B=100.y.y.y
# If B cannot bind mesh :47989, set the port it actually uses:
# MESH_WEB_PORT_B=18789

ST_DEVICE_A=
ST_DEVICE_B=
ST_FOLDER_ID=sync
SYNC_FOLDER=$HOME/sync
